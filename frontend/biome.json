{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 2097152,
    "includes": [
      "**",
      "!src/api/schema.d.ts",
      "!src/api/public-events.ts",
      "!src/design-system/material-symbols"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 300,
            "skipBlankLines": true
          }
        }
      },
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "Select",
              "Textarea",
              "TextInput",
              "SearchField",
              "MoneyInput"
            ]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "useImportType": "error",
        "useCollapsedElseIf": "error",
        "useShorthandAssign": "error",
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/**", "src/api/**", "src/i18n/**", "src/format/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app",
                      "**/app/**",
                      "**/features",
                      "**/features/**",
                      "**/App",
                      "**/components",
                      "**/components/**",
                      "!@composition/**"
                    ],
                    "message": "A base layer (lib, api, i18n, format) is imported by the components, the features and the shell, so it never imports them back. Move the shared code down into lib/ instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/design-system/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app",
                      "**/app/**",
                      "**/features",
                      "**/features/**",
                      "**/App",
                      "**/components",
                      "**/components/**",
                      "!@composition/**"
                    ],
                    "message": "The design system draws what the components, the features and the shell compose, so it never imports them. A piece that needs a feature's data belongs in components/ or in that feature; a shared helper belongs in lib/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app",
                      "**/app/**",
                      "**/features",
                      "**/features/**",
                      "**/App",
                      "!@composition/**"
                    ],
                    "message": "A component is shared by many features, so it never imports a feature or the shell. Move what it needs down into components/ or lib/, or keep the piece in its feature."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
