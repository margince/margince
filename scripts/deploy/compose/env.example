# Copy to .env and fill in. Make each secret once, for example:
#   openssl rand -hex 24        for a password
#   openssl rand -base64 32     for MARGINCE_KEYVAULT_ROOT_KEY
# Keep MARGINCE_KEYVAULT_ROOT_KEY apart from your backups: every secret the
# app stores is sealed with it, and without it they cannot be read.

# The superuser of the bundled PostgreSQL, and the two roles Margince uses.
POSTGRES_PASSWORD=
MARGINCE_OWNER_PW=
MARGINCE_APP_PW=

# The URL your users open, with no path: https://crm.example.com
MARGINCE_PUBLIC_BASE_URL=
MARGINCE_KEYVAULT_ROOT_KEY=
# The license token. A free one for up to 3 seats: https://dist.margince.com/free-license
MARGINCE_LICENSE=
# Empty is production. dev or test runs with no license, for a trial only.
MARGINCE_ENV=

# The first admin's password, read on the first start only. Remove it after.
MARGINCE_ADMIN_PASSWORD=

# The host port the front server listens on; put TLS in front of it.
MARGINCE_PORT=8080
