# Written by tools/gen-config; run `make config-gen` after a change.
#
# Every variable a Margince program or image entrypoint reads, commented out at its default. Copy
# a line to .env.local (git-ignored) and remove its "# " to set it. A secret has no default. What
# each variable does is in docs/reference/configuration.md.

# ---- required by the image entrypoint ----
# MARGINCE_DSN=
# MARGINCE_OWNER_DSN=

# ---- loader ----
# MARGINCE_ENV=
# MARGINCE_CONFIG=
# MARGINCE_CONFIG_FILE=
# MARGINCE_ENV_FILE=
# MARGINCE_CONFIG_TRACE=

# ---- image entrypoint ----
# MARGINCE_ADMIN_PASSWORD=

# ---- top-level keys ----
# MARGINCE_ADDR=:8080
# MARGINCE_AI_FAKE=false
# MARGINCE_AI_ROUTING=
# MARGINCE_API_BASE_URL=
# MARGINCE_BLOBSTORE_ACCESS_KEY=
# MARGINCE_BLOBSTORE_BUCKET=
# MARGINCE_BLOBSTORE_ENDPOINT=
# MARGINCE_BLOBSTORE_PATH=
# MARGINCE_BLOBSTORE_REGION=
# MARGINCE_BLOBSTORE_SECRET_KEY=
# MARGINCE_BLOBSTORE_USE_SSL=false
# MARGINCE_CERTLOG_BASE_URL=
# MARGINCE_CONNECTOR_STATE_KEY=
# MARGINCE_GEOCODE_BASE_URL=
# MARGINCE_GMAIL_CLIENT_ID=
# MARGINCE_GMAIL_CLIENT_SECRET=
