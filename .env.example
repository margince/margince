# Written by tools/gen-config from the settings registry; run `make config-gen` after a change.
#
# Every variable a Margince program or image entrypoint reads, commented out at its default. Copy
# what you need to .env.local (gitignored); a deployment supplies these through its own environment
# or secret store. A secret has no default: write the value itself here, never in a committed file.
# [required] marks a variable the image entrypoint refuses to start without.
# docs/reference/configuration.md lists each setting with the key it sets in margince.yaml.

# ---- loader ----

# The posture: dev or test runs without a license, and unset or any other value is production.
# MARGINCE_ENV=

# Base YAML file; margince.yaml when unset.
# MARGINCE_CONFIG=

# YAML file layered over the base file.
# MARGINCE_CONFIG_FILE=

# .env file to read.
# MARGINCE_ENV_FILE=

# Log every configuration source and the origin of each setting.
# MARGINCE_CONFIG_TRACE=

# ---- image entrypoint ----

# Read by scripts/deploy/api-entrypoint.sh before it starts a program.
# MARGINCE_ADMIN_PASSWORD=

# ---- top-level keys ----

# Listen address of the HTTP server.
# MARGINCE_ADDR=:8080

# Drive the AI surfaces with the offline fake model when nothing else can serve (dev and test
# only).
# MARGINCE_AI_FAKE=false

# Ignored; kept so existing command lines parse.
# MARGINCE_AI_ROUTING=

# External base of the api for the OAuth redirect_uri when the api and the SPA are on different
# origins; defaults to --public-base-url.
# MARGINCE_API_BASE_URL=

# Access key for the object store.
# MARGINCE_BLOBSTORE_ACCESS_KEY=

# Bucket attachments are written to.
# MARGINCE_BLOBSTORE_BUCKET=

# Endpoint of an object store such as MinIO for attachment bytes; it wins over
# MARGINCE_BLOBSTORE_PATH, and with both unset the attachment endpoints answer 501.
# MARGINCE_BLOBSTORE_ENDPOINT=

# Directory attachment bytes are written to when there is no object storage service; ignored when
# MARGINCE_BLOBSTORE_ENDPOINT is set.
# MARGINCE_BLOBSTORE_PATH=

# Region the bucket lives in.
# MARGINCE_BLOBSTORE_REGION=

# Secret key for the object store.
# MARGINCE_BLOBSTORE_SECRET_KEY=

# Reach the object store over TLS.
# MARGINCE_BLOBSTORE_USE_SSL=false

# Base URL of a certificate log, or public for a free public one; unset makes no outbound lookups
# of what a company runs.
# MARGINCE_CERTLOG_BASE_URL=

# HMAC key of at least 32 bytes signing the OAuth connect state; required for the Gmail and Graph
# connect flows.
# MARGINCE_CONNECTOR_STATE_KEY=

# [required] Postgres DSN of the runtime app role; migrate falls back to it when
# MARGINCE_OWNER_DSN is unset.
# MARGINCE_DSN=

# Nominatim base URL; unset or public uses the public service, off stops the lookup of map points;
# give the api and the worker the same value, or a lookup is never queued.
# MARGINCE_GEOCODE_BASE_URL=

# Google OAuth client id of the Gmail capture connector.
# MARGINCE_GMAIL_CLIENT_ID=

# Google OAuth client secret of the Gmail capture connector.
# MARGINCE_GMAIL_CLIENT_SECRET=

# Override of the Google OIDC JWKS URL, for test and dev.
# MARGINCE_GMAIL_JWKS_URL=

# Gmail Pub/Sub topic (projects/<p>/topics/<t>) that enables the push-watch job; unset leaves
# capture on the poll.
# MARGINCE_GMAIL_PUBSUB_TOPIC=

# OIDC audience the Pub/Sub push subscription mints tokens for.
# MARGINCE_GMAIL_PUSH_AUDIENCE=

# Google service account email that signs the Pub/Sub push OIDC tokens.
# MARGINCE_GMAIL_PUSH_SERVICE_ACCOUNT=

# Shared secret on the Pub/Sub push URL; unset, POST /webhooks/gmail is absent.
# MARGINCE_GMAIL_PUSH_TOKEN=

# Microsoft Entra app id of the Outlook and Microsoft 365 capture connector.
# MARGINCE_GRAPH_CLIENT_ID=

# Microsoft client secret of the Outlook and Microsoft 365 capture connector.
# MARGINCE_GRAPH_CLIENT_SECRET=

# Public URL, token included, that Microsoft posts Graph change notices to; unset leaves Outlook
# capture on the poll.
# MARGINCE_GRAPH_NOTIFICATION_URL=

# Shared secret on the Graph change notice URL; unset, POST /webhooks/graph is absent.
# MARGINCE_GRAPH_PUSH_TOKEN=

# Microsoft identity tenant of the capture consent endpoint and token refresh; unset means common.
# MARGINCE_GRAPH_TENANT=

# Run the outbox relay in this process; false when cmd/worker runs it.
# MARGINCE_INLINE_RELAY=true

# How long a running job gets to finish at shutdown; the grace period must cover it, five more
# seconds and the shutdown steps.
# MARGINCE_JOB_DRAIN_WINDOW=20s

# Standard Base64 of the 32-byte root key that seals connector credentials; unset disables the
# vault.
# MARGINCE_KEYVAULT_ROOT_KEY=

# Log format.
# MARGINCE_LOG_FORMAT=text

# Log level.
# MARGINCE_LOG_LEVEL=info

# Origin the api reads the MCP App view documents from; defaults to --public-base-url.
# MARGINCE_MCP_APPS_BASE_URL=

# Who /metrics serves: token requires --metrics-token, open serves any client that reaches the
# port.
# MARGINCE_METRICS_ACCESS=token

# Bearer credential /metrics requires; unset, /metrics refuses every scrape unless
# --metrics-access=open.
# MARGINCE_METRICS_TOKEN=

# Comma-separated Entra directory ids whose members may sign in; defaults to --graph-tenant when
# that names a directory.
# MARGINCE_MICROSOFT_SIGNIN_TENANT=

# Address the worker serves its /healthz, /readyz and /metrics on, such as 127.0.0.1:9101; unset
# serves nothing.
# MARGINCE_OBSERVE_ADDR=

# Serve the Go profiles under /debug/pprof/ on the --observe-addr listener with no sign-in; turn
# it on only to find a fault.
# MARGINCE_OBSERVE_PPROF=false

# [required] Postgres DSN of the owner role, which migrate applies the schema with.
# MARGINCE_OWNER_DSN=

# Enrichment provider: live, offline or off; an unknown value fails the boot.
# MARGINCE_PROVIDER_SURFE=live

# External scheme and host for the links a buyer sees and for the OAuth callback; required to send
# mail.
# MARGINCE_PUBLIC_BASE_URL=

# Redis address of the event bus.
# MARGINCE_REDIS=localhost:16379

# Event-bus credential, where the Redis server requires one.
# MARGINCE_REDIS_PASSWORD=

# Postgres DSN of the owner role for custom-field schema changes; unset, those two operations
# answer 501.
# MARGINCE_SCHEMA_DSN=

# Comma-separated CIDR prefixes of the reverse proxies whose client address header the rate limits
# per IP trust.
# MARGINCE_TRUSTED_PROXIES=

# VIES base URL, or public; set it on the api and the worker together, or a VAT check is never
# queued.
# MARGINCE_VAT_CHECK_BASE_URL=

# Base64 32-byte key sealing outbound-webhook signing secrets; unset, the webhook paths that
# change data answer 503 and the worker sends nothing.
# MARGINCE_WEBHOOK_KEY=

# Directory where the AI task probes of the worker write their files.
# MARGINCE_AITASK_DIR=.tmp/aitask

# ---- activities ----

# Days a sent message may go without a reply before its sender is asked to follow up.
# MARGINCE_ACTIVITIES_FOLLOW_UP_AFTER_DAYS=2

# ---- ai ----

# The monthly AI token budget of the company, as tokens_per_full_user and company_monthly_tokens
# (null for the total over its users).
# MARGINCE_AI_BUDGET={"tokens_per_full_user":12000000,"company_monthly_tokens":null}

# Keep each AI call's request and answer in ai_call_payload, aged by its retention policy; set it
# on the api and the worker together.
# MARGINCE_AI_CAPTURE_PAYLOADS=false

# Whether the daily job syncs model prices, as {"auto_sync": true|false}. Refresh now runs either
# way.
# MARGINCE_AI_PRICE_SYNC={"auto_sync":true}

# BYOK API key for the Anthropic provider; required only when a binding names it.
# ANTHROPIC_API_KEY=

# BYOK API key for the Gemini provider; required only when a binding names it.
# GEMINI_API_KEY=

# BYOK service-account key (the JSON key file's contents) for the gemini_vertex provider; required
# only when a binding names it.
# GEMINI_VERTEX_SA_JSON=

# API key for the TypeSafe decision provider; required only when the decisions lane binds it.
# TYPESAFE_API_KEY=

# API key for a jev_compatible decision server; sent when set and never required.
# JEV_COMPATIBLE_API_KEY=

# BYOK API key for the OpenAI provider; required only when a binding names it.
# OPENAI_API_KEY=

# BYOK API key for the openai_compatible provider; required only when a binding names it.
# OPENAI_COMPATIBLE_API_KEY=

# The tier-to-model binding, in the shape seeds.ai_routing takes (JSON in the environment). Unset
# binds no models.
# MARGINCE_AI_ROUTING_BINDING=

# Each task's thinking level and timeouts, as the JSON object PUT /ai/task-overrides takes. Unset
# keeps the product's values.
# MARGINCE_AI_TASK_OVERRIDES={}

# ---- analytics ----

# Ignored; kept so existing files load.
# MARGINCE_ANALYTICS_PERFORMANCE_ENABLED=false

# ---- auth ----

# Email and password sign-in; an installation behind its own identity provider turns it off.
# MARGINCE_AUTH_PASSWORD_ENABLED=true

# ---- capture ----

# Read a new contact's company web page automatically.
# MARGINCE_CAPTURE_AUTO_ENRICH=true

# Automatic company web-page reads the installation may start in one UTC day.
# MARGINCE_CAPTURE_AUTO_ENRICH_DAILY_CAP=500

# Held mail threads one review pass may judge; the rest wait for the next pass.
# MARGINCE_CAPTURE_CONFIDENTIALITY_PASS_CAP=40

# Ignored, with a warning at boot; the consumer-mail list is edited under Settings.
# MARGINCE_CAPTURE_FREEMAIL_EXTRA=

# Ignored, with a warning at boot; the consumer-mail list is edited under Settings.
# MARGINCE_CAPTURE_FREEMAIL_NEVER=

# Let every colleague who can see a contact read the email captured with them; off keeps new mail
# to those on it.
# MARGINCE_CAPTURE_MAIL_SHARING=true

# Seconds a working mailbox connection waits between polls.
# MARGINCE_CAPTURE_MAIL_SYNC_INTERVAL_SECONDS=120

# How far back a mailbox import may reach, for the whole installation; 0 is no cap.
# MARGINCE_CAPTURE_MAX_BACKFILL_MONTHS=0

# Allow a seat to share their mailbox with colleagues as mail lands; turn it on only where a works
# agreement allows it.
# MARGINCE_CAPTURE_SHARED_POSTURE_ALLOWED=false

# Read contact details from the signatures and attached cards of captured mail, for every mailbox
# that has made no choice of its own.
# MARGINCE_CAPTURE_SIGNATURE_ENRICH=true

# MiB one company web-page read may hold, over all its pages.
# MARGINCE_CAPTURE_SITE_READ_MAX_MIB=32

# Pages one company web-page read may fetch.
# MARGINCE_CAPTURE_SITE_READ_MAX_PAGES=60

# Seconds one company web-page read may run before it stops and extracts what it has.
# MARGINCE_CAPTURE_SITE_READ_WALL_SECONDS=240

# Raise no contact proposal for a sender on an RFC 2606 reserved name; the mail is still captured.
# MARGINCE_CAPTURE_SKIP_RESERVED_DOMAIN_PROPOSALS=true

# Keep each traced message's sender and a bounded subject in the 24-hour capture trace, dropped
# messages included.
# MARGINCE_CAPTURE_TRACE_PAYLOADS=true

# Domains of mail services added to the built-in list; their mail keeps the activity and derives
# no counterparty.
# MARGINCE_CAPTURE_TRANSACTIONAL_EXTRA=

# Domains never held back as system mail, whatever the built-in rules say.
# MARGINCE_CAPTURE_TRANSACTIONAL_NEVER=

# ---- company_context ----

# Company-context stage: off, read (reads and settings), tasks (AI tasks get it) or onboarding
# (the first-run flow too).
# MARGINCE_COMPANY_CONTEXT_ROLLOUT=onboarding

# ---- consent ----

# How strictly the authorization engine applies its answer for each message category: observe,
# warn or enforce.
# MARGINCE_CONSENT_AUTHORIZATION_MODES=account_notice:enforce,active_deal_followup:enforce,consent_confirmation:enforce,contract_notice:enforce,customer_service:enforce,invoice_or_payment:enforce,marketing:enforce,optout_confirmation:enforce,precontract_quote:enforce,privacy_notice:enforce,record_confirmation:enforce,reply_to_inbound:enforce,requested_followup:enforce,security_notice:enforce

# Who this installation is, as every message it sends must say: legal name, address, privacy
# contact, how to object, and advertiser contact.
# MARGINCE_CONSENT_CONTROLLER_PARTICULARS=

# ---- contacts ----

# Track a first-response target on every lead.
# MARGINCE_CONTACTS_FIRST_RESPONSE_ENABLED=false

# Minutes a lead may wait for its first real response once its clock starts.
# MARGINCE_CONTACTS_FIRST_RESPONSE_TARGET_MINUTES=240

# The email signature of the workspace, used in place of the own signature of each sender; empty
# means none.
# MARGINCE_CONTACTS_SIGNATURE_TEMPLATE=

# The user id of the colleague who answers for a lead nobody owns, or whose owner has left, once
# it misses its target; empty means nobody, and a boot value that names no active colleague
# reaches nobody and logs a warning.
# MARGINCE_CONTACTS_UNASSIGNED_ESCALATION_USER_ID=

# ---- data_tasks ----

# Delay between saved batches of data tasks.
# MARGINCE_DATA_TASKS_PACE=1s

# ---- deals ----

# Let a deal be sent to legal for review, and let a legal_reviewed criterion hold a deal at its
# stage.
# MARGINCE_DEALS_LEGAL_REVIEW_ENABLED=true

# Let the nightly close-date sweep write to a deal. Off stops every automatic write the sweep
# makes.
# MARGINCE_DEALS_MAINTENANCE_WRITES_ENABLED=true

# Let a deal move to the next stage by itself where the rule of its stage allows it; off stops
# every automatic move.
# MARGINCE_DEALS_STAGE_AUTOPILOT_ENABLED=false

# ---- email ----

# Send the installation's own mail through the SMTP relay below; needs --public-base-url.
# MARGINCE_EMAIL_ENABLED=false

# Sender address of the installation's own mail; required when email.enabled.
# MARGINCE_EMAIL_FROM_ADDRESS=

# SMTP relay host; required when email.enabled.
# MARGINCE_SMTP_HOST=

# SMTP relay password, sealed into the key vault at boot; ${none} deletes the sealed copy and
# sends without one.
# MARGINCE_SMTP_PASSWORD=

# Path to a file holding the SMTP relay password; a password set by reference wins over it.
# MARGINCE_SMTP_PASSWORD_FILE=

# SMTP relay port, 1 to 65535 when email.enabled.
# MARGINCE_SMTP_PORT=0

# SMTP relay user; unset sends without signing in.
# MARGINCE_SMTP_USERNAME=

# ---- identity ----

# The sign-in providers offered, as a list of provider keys; unset offers every provider the
# deployment set up.
# MARGINCE_IDENTITY_ENABLED_OIDC_PROVIDERS=

# AI tools may register their own OAuth client (DCR) for new sign-ins.
# MARGINCE_IDENTITY_OAUTH_DYNAMIC_REGISTRATION=true

# AI tools may sign in with a client ID that is the URL of their metadata document (CIMD).
# MARGINCE_IDENTITY_OAUTH_METADATA_DOCUMENTS=true

# The role each directory group grants at sign-in, as group:role pairs; it only grants, and never
# removes a role.
# MARGINCE_IDENTITY_OIDC_GROUP_ROLE_MAP=

# Every member must use two-step sign-in.
# MARGINCE_IDENTITY_REQUIRE_MFA=false

# Members other than admins sign in only through a sign-in provider.
# MARGINCE_IDENTITY_REQUIRE_SSO=false

# ---- installation ----

# Calls of any kind, tool or API, one agent passport may make per window.
# MARGINCE_INSTALLATION_AGENT_CALLS_PER_WINDOW=1000

# Calls that send something out of the workspace one agent passport may make per window.
# MARGINCE_INSTALLATION_AGENT_EGRESS_PER_WINDOW=20

# Seconds between the passes of the agent scheduler.
# MARGINCE_INSTALLATION_AGENT_RUNNER_INTERVAL_SECONDS=30

# Hours in the window the agent limits count over; set at boot, it also keeps a length an admin
# saved for the next reset from taking over.
# MARGINCE_INSTALLATION_AGENT_WINDOW_HOURS=24

# Changing calls one agent passport may make per window.
# MARGINCE_INSTALLATION_AGENT_WRITES_PER_WINDOW=200

# The language AI writes the shared record in: en, de or vi.
# MARGINCE_INSTALLATION_BASE_LANGUAGE=en

# Show a Telegram chat link next to a contact's phone number that starts with a country code.
# MARGINCE_INSTALLATION_CALL_TELEGRAM=true

# Show a WhatsApp chat link next to a contact's phone number that starts with a country code.
# MARGINCE_INSTALLATION_CALL_WHATSAPP=true

# Show a Zalo chat link next to a contact's phone number that starts with a country code.
# MARGINCE_INSTALLATION_CALL_ZALO=true

# Seconds between the close-date sweeps.
# MARGINCE_INSTALLATION_CLOSE_DATE_SWEEP_INTERVAL_SECONDS=86400

# Where the installation is established, as a two-letter ISO 3166-1 code in small letters; empty
# for none.
# MARGINCE_INSTALLATION_COUNTRY=

# How dates are written: locale, dmy, mdy or ymd.
# MARGINCE_INSTALLATION_DATE_FORMAT=locale

# Hours the job-health banner looks back before it calls dead work a problem.
# MARGINCE_INSTALLATION_DEAD_WORK_BANNER_HOURS=24

# The month the business year begins, 1 to 12.
# MARGINCE_INSTALLATION_FISCAL_YEAR_START_MONTH=1

# Seconds between the follow-up reconcile passes.
# MARGINCE_INSTALLATION_FOLLOW_UP_RECONCILE_INTERVAL_SECONDS=86400

# Which remaining-pipeline reading a projected landing is built from.
# MARGINCE_INSTALLATION_FORECAST_FORWARD_MEASURE=commit_evidence

# Seconds between the sweeps that add missing map points, or 0 for off.
# MARGINCE_INSTALLATION_GEOCODE_BACKFILL_INTERVAL_SECONDS=3600

# Hours before a Gmail push subscription ends that it is renewed.
# MARGINCE_INSTALLATION_GMAIL_WATCH_RENEW_WITHIN_HOURS=48

# Seconds between the scans for Gmail push subscriptions due for renewal.
# MARGINCE_INSTALLATION_GMAIL_WATCH_SCAN_INTERVAL_SECONDS=21600

# Hours before a Microsoft Graph mail subscription ends that it is renewed.
# MARGINCE_INSTALLATION_GRAPH_WATCH_RENEW_WITHIN_HOURS=24

# Seconds between the scans for Microsoft Graph mail subscriptions due for renewal.
# MARGINCE_INSTALLATION_GRAPH_WATCH_SCAN_INTERVAL_SECONDS=21600

# The company's name. Set at boot, it also refuses a different name on the company profile.
# MARGINCE_INSTALLATION_NAME=

# Minutes an access token from the OAuth handshake of a connector lives, for the first token and
# every refresh.
# MARGINCE_INSTALLATION_OAUTH_ACCESS_TOKEN_TTL_MINUTES=43200

# Seconds between the retention sweeps.
# MARGINCE_INSTALLATION_RETENTION_SWEEP_INTERVAL_SECONDS=86400

# Hours a delivery held back by the send rate may wait before it stops with a reason.
# MARGINCE_INSTALLATION_SEND_MAX_AGE_HOURS=24

# Messages one mailbox may send per send-rate window.
# MARGINCE_INSTALLATION_SEND_RATE_LIMIT=30

# Seconds in the window the send rate is counted over.
# MARGINCE_INSTALLATION_SEND_RATE_WINDOW_SECONDS=60

# Seconds between the sweeps that add missing technical profiles, or 0 for off.
# MARGINCE_INSTALLATION_TECHNICAL_BACKFILL_INTERVAL_SECONDS=21600

# How times of day are written: locale, 24h or 12h.
# MARGINCE_INSTALLATION_TIME_FORMAT=locale

# Seconds between the time-scan passes.
# MARGINCE_INSTALLATION_TIME_SCAN_INTERVAL_SECONDS=3600

# Seconds between the passes that retry failed webhook deliveries.
# MARGINCE_INSTALLATION_WEBHOOK_RETRY_INTERVAL_SECONDS=30

# ---- integrations ----

# Look each new contact up once against the connected data provider for the free details, with no
# request from a user.
# MARGINCE_INTEGRATIONS_AUTOMATIC_LOOKUP=true

# ---- license ----

# Licence token; unset with no license.token_file runs with no license, which production refuses.
# MARGINCE_LICENSE=

# Path to a file holding the licence token, read again at each licence check; license.token wins
# over it.
# MARGINCE_LICENSE_TOKEN_FILE=

# ---- lists ----

# Live Lists and Shortlists; false hides every list surface and deletes no list.
# MARGINCE_LISTS_ENABLED=true

# ---- mcp ----

# Let AI tools register their own OAuth client at /oauth/register (DCR); false keeps it off
# whatever the admin's switch in Settings > MCP says.
# MARGINCE_MCP_CLIENT_REGISTRATION_DYNAMIC=true

# Accept a client ID that is the URL of the tool's published metadata document (CIMD); false keeps
# it off whatever the admin's switch in Settings > MCP says.
# MARGINCE_MCP_CLIENT_REGISTRATION_METADATA_DOCUMENT=true

# Serve /mcp and the OAuth authorization server to outside agent clients; needs --public-base-url.
# MARGINCE_MCP_CONNECTOR_ENABLED=false

# ---- operations ----

# Arm POST /v1/admin/reset-data, which purges this installation's tenant data back to its
# first-boot state.
# MARGINCE_OPERATIONS_ALLOW_DATA_RESET=false

# Arm the test_mailbox connector, a no-network fake mailbox that captures and sends; never on a
# real deployment.
# MARGINCE_OPERATIONS_ALLOW_TEST_MAILBOX=false

# ---- privacy ----

# Keep everything: the nightly retention pass erases nothing and strips no personal data, whatever
# a policy says.
# MARGINCE_PRIVACY_RETAIN_ONLY=false

# ---- rates ----

# ISO 4217 codes the FX refresh offers for an empty rate sheet; unset offers USD, GBP and CHF.
# MARGINCE_RATES_FX_CURRENCIES=

# Page the FX refresh reads rates from; unset reads a free source of ECB rates.
# MARGINCE_RATES_FX_SOURCE=

# Ignored, with a warning at boot; kept so existing files load.
# MARGINCE_RATES_MODEL_PRICING=

# ---- uploads ----

# Largest request POST /v1/attachments takes, in decimal MB.
# MARGINCE_UPLOADS_ATTACHMENT_MB=25

# Largest request POST /v1/imports/sources and the vCard import take, in decimal MB.
# MARGINCE_UPLOADS_CSV_IMPORT_MB=10

# Largest document POST /v1/knowledge/corpora/{id}/documents takes, in decimal MB.
# MARGINCE_UPLOADS_KNOWLEDGE_DOCUMENT_MB=5

# Largest request POST /v1/me/linkedin-connections takes, in decimal MB.
# MARGINCE_UPLOADS_LINKEDIN_IMPORT_MB=8

# ---- web ----

# RFC 9116 security.txt: one or more contact URIs and an RFC 3339 end time, with an optional
# policy link and preferred_languages.
# MARGINCE_WEB_SECURITY_TXT=null
