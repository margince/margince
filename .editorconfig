root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml,md,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Copied third-party files stay byte for byte as published.
[frontend/src/design-system/material-symbols/**]
insert_final_newline = false
trim_trailing_whitespace = false
